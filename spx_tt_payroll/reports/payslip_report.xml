<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_tt_payroll_payslip" model="report.paperformat">
        <field name="name">TT Payroll Payslip - A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_tt_payroll_payslip_pdf" model="ir.actions.report">
        <field name="name">TT Payroll Payslip</field>
        <field name="model">spx.tt.payroll.run.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">spx_tt_payroll.report_tt_payroll_payslip</field>
        <field name="report_file">spx_tt_payroll.report_tt_payroll_payslip</field>
        <field name="binding_model_id" ref="model_spx_tt_payroll_run_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_tt_payroll_payslip"/>
        <field name="print_report_name">'Payslip - %s - %s' % (object.employee_id.name, object.run_id.name)</field>
    </record>

    <record id="action_report_tt_payroll_payslip_preview" model="ir.actions.report">
        <field name="name">TT Payroll Payslip Preview</field>
        <field name="model">spx.tt.payroll.run.employee</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">spx_tt_payroll.report_tt_payroll_payslip</field>
        <field name="report_file">spx_tt_payroll.report_tt_payroll_payslip</field>
        <field name="paperformat_id" ref="paperformat_tt_payroll_payslip"/>
    </record>
</odoo>
