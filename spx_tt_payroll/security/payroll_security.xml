<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tt_payroll" model="ir.module.category">
        <field name="name">TT Payroll</field>
        <field name="description">Access to Trinidad &amp; Tobago payroll information and processes.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_tt_payroll_access" model="res.groups.privilege">
        <field name="name">Payroll Access</field>
        <field name="description">Controls preparation and management access for TT Payroll.</field>
        <field name="category_id" ref="spx_tt_payroll.module_category_tt_payroll"/>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_tt_payroll_approval" model="res.groups.privilege">
        <field name="name">Payroll Approval</field>
        <field name="description">Controls the independent payroll review responsibility.</field>
        <field name="category_id" ref="spx_tt_payroll.module_category_tt_payroll"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_tt_payroll_user" model="res.groups">
        <field name="name">Payroll User</field>
        <field name="privilege_id" ref="spx_tt_payroll.privilege_tt_payroll_access"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Can view payroll-ready employees and payroll configuration.</field>
    </record>

    <record id="group_tt_payroll_officer" model="res.groups">
        <field name="name">Payroll Officer</field>
        <field name="privilege_id" ref="spx_tt_payroll.privilege_tt_payroll_access"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="comment">Can prepare employee payroll information, payroll runs, earnings, and deductions.</field>
    </record>

    <record id="group_tt_payroll_reviewer" model="res.groups">
        <field name="name">Payroll Reviewer</field>
        <field name="privilege_id" ref="spx_tt_payroll.privilege_tt_payroll_approval"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
        <field name="comment">Can review employee payroll calculations before approval.</field>
    </record>

    <record id="group_tt_payroll_manager" model="res.groups">
        <field name="name">Payroll Manager</field>
        <field name="privilege_id" ref="spx_tt_payroll.privilege_tt_payroll_access"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_officer')), (4, ref('hr.group_hr_manager')), (4, ref('spx_tt_payroll.group_tt_payroll_reviewer'))]"/>
        <field name="comment">Can configure, approve, and manage Trinidad payroll.</field>
    </record>

    <record id="rule_tt_payroll_group_company" model="ir.rule">
        <field name="name">Payroll groups by company</field>
        <field name="model_id" ref="model_spx_tt_payroll_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_pay_item_company" model="ir.rule">
        <field name="name">Payroll items by company</field>
        <field name="model_id" ref="model_spx_tt_pay_item"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_employee_pay_item_company" model="ir.rule">
        <field name="name">Employee payroll items by company</field>
        <field name="model_id" ref="model_spx_tt_employee_pay_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>


    <record id="rule_tt_payroll_run_company" model="ir.rule">
        <field name="name">Payroll runs by company</field>
        <field name="model_id" ref="model_spx_tt_payroll_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_payroll_run_employee_company" model="ir.rule">
        <field name="name">Payroll employee calculations by company</field>
        <field name="model_id" ref="model_spx_tt_payroll_run_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_payroll_run_item_company" model="ir.rule">
        <field name="name">Payroll run items by company</field>
        <field name="model_id" ref="model_spx_tt_payroll_run_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_payroll_hours_adjustment_company" model="ir.rule">
        <field name="name">Payroll hours adjustments by company</field>
        <field name="model_id" ref="model_spx_tt_payroll_hours_adjustment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_payroll_time_off_snapshot_company" model="ir.rule">
        <field name="name">Payroll Time Off snapshots by company</field>
        <field name="model_id" ref="model_spx_tt_payroll_time_off_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_user'))]"/>
    </record>

    <record id="rule_tt_payroll_officer_read_company_time_off" model="ir.rule">
        <field name="name">Payroll officers can review company Time Off</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('spx_tt_payroll.group_tt_payroll_officer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
