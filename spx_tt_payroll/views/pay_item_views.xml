<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_pay_item_list" model="ir.ui.view">
        <field name="name">spx.tt.pay.item.list</field>
        <field name="model">spx.tt.pay.item</field>
        <field name="arch" type="xml">
            <list string="Earnings and Deductions" multi_edit="1"
                  decoration-success="category == 'earning'"
                  decoration-danger="category == 'deduction'"
                  decoration-info="category == 'employer'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category" widget="badge"/>
                <field name="calculation_method"/>
                <field name="taxable" optional="show"/>
                <field name="nis_applicable" optional="show"/>
                <field name="recurring_allowed" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tt_pay_item_form" model="ir.ui.view">
        <field name="name">spx.tt.pay.item.form</field>
        <field name="model">spx.tt.pay.item</field>
        <field name="arch" type="xml">
            <form string="Payroll Item">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="calculation_method"/>
                            <field name="statutory_code"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                            <field name="is_system" readonly="1"/>
                        </group>
                    </group>
                    <group string="Default Calculation">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="default_amount" invisible="calculation_method != 'fixed'"/>
                            <field name="default_percentage" invisible="calculation_method != 'percentage'"/>
                        </group>
                        <group>
                            <field name="taxable"/>
                            <field name="nis_applicable"/>
                            <field name="recurring_allowed"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tt_pay_item_search" model="ir.ui.view">
        <field name="name">spx.tt.pay.item.search</field>
        <field name="model">spx.tt.pay.item</field>
        <field name="arch" type="xml">
            <search string="Earnings and Deductions">
                <field name="name"/>
                <field name="code"/>
                <filter string="Earnings" name="earnings" domain="[('category', '=', 'earning')]"/>
                <filter string="Deductions" name="deductions" domain="[('category', '=', 'deduction')]"/>
                <filter string="Employer Contributions" name="employer" domain="[('category', '=', 'employer')]"/>
                <filter string="Statutory" name="statutory" domain="[('statutory_code', '!=', 'none')]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Calculation" name="group_calculation" context="{'group_by': 'calculation_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tt_pay_items" model="ir.actions.act_window">
        <field name="name">Earnings and Deductions</field>
        <field name="res_model">spx.tt.pay.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tt_pay_item_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an earning or deduction</p>
            <p>Standard Trinidad payroll items are already included and can be adjusted when needed.</p>
        </field>
    </record>
</odoo>
