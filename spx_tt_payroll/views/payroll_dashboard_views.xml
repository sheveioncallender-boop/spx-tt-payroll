<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_payroll_dashboard_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.dashboard.form</field>
        <field name="model">spx.tt.payroll.dashboard</field>
        <field name="arch" type="xml">
            <form string="Payroll Dashboard" create="0" edit="0" delete="0" class="o_tt_payroll_dashboard_form">
                <header>
                    <button name="action_create_payroll_run" type="object" string="New Payroll Run" class="btn-primary" icon="fa-plus" groups="spx_tt_payroll.group_tt_payroll_officer"/>
                    <button name="action_select_payroll" type="object" string="Select Payroll" class="btn-secondary" icon="fa-exchange"/>
                    <button name="action_use_latest_payroll" type="object" string="Latest Payroll" class="btn-secondary" icon="fa-calendar-check-o"/>
                    <button name="action_refresh_dashboard" type="object" string="Refresh" class="btn-secondary" icon="fa-refresh"/>
                </header>
                <sheet class="o_tt_dashboard_sheet">
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="payroll_run_id" invisible="1"/>
                    <field name="has_current_run" invisible="1"/>

                    <div class="o_tt_dashboard_heading">
                        <div>
                            <h1>Payroll Dashboard</h1>
                            <p>
                                Live payroll control centre for
                                <field name="company_id" nolabel="1" readonly="1"/>
                            </p>
                        </div>
                        <div class="o_tt_dashboard_heading_actions">
                            <button name="action_select_payroll" type="object" string="Change Payroll" class="btn-primary" icon="fa-exchange"/>
                            <button name="action_open_payroll_runs" type="object" string="View Payroll Runs" class="btn-secondary" icon="fa-list"/>
                        </div>
                    </div>

                    <section class="o_tt_dashboard_control_bar" invisible="not has_current_run">
                        <div class="o_tt_control_identity">
                            <span class="o_tt_control_label">Dashboard Payroll</span>
                            <strong><field name="run_name" nolabel="1" readonly="1"/></strong>
                            <span><field name="run_frequency" nolabel="1" readonly="1"/> | <field name="run_period" nolabel="1" readonly="1"/></span>
                        </div>
                        <div class="o_tt_control_progress">
                            <span>Payroll preparation</span>
                            <field name="overall_progress" widget="progressbar" nolabel="1" readonly="1"/>
                        </div>
                        <button name="action_open_current_run" type="object" string="Continue Payroll" class="btn-primary" icon="fa-arrow-right"/>
                    </section>

                    <div class="o_tt_dashboard_grid">
                        <section class="o_tt_dashboard_card o_tt_card_primary">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-calendar-check-o"/></div>
                                <div>
                                    <h3>Current Payroll</h3>
                                    <span>Selected payroll and completion progress</span>
                                </div>
                            </div>
                            <div class="o_tt_card_body">
                                <div class="o_tt_run_title"><field name="run_name" nolabel="1" readonly="1"/></div>
                                <div class="o_tt_run_meta" invisible="not has_current_run">
                                    <span><field name="run_frequency" nolabel="1" readonly="1"/></span>
                                    <span><field name="run_period" nolabel="1" readonly="1"/></span>
                                    <span>Pay date: <field name="run_pay_date" nolabel="1" readonly="1"/></span>
                                </div>
                                <div class="o_tt_status_row" invisible="not has_current_run">
                                    <field name="run_state" widget="badge" nolabel="1" readonly="1"
                                           decoration-info="run_state == 'draft'"
                                           decoration-warning="run_state in ('attendance_review', 'under_review')"
                                           decoration-primary="run_state == 'calculated'"
                                           decoration-success="run_state in ('approved', 'paid')"/>
                                    <strong><field name="payroll_payable_count" nolabel="1" readonly="1"/> payable employees</strong>
                                </div>
                                <div class="o_tt_progress_stack" invisible="not has_current_run">
                                    <div>
                                        <span>Attendance confirmed</span>
                                        <field name="attendance_progress" widget="progressbar" nolabel="1" readonly="1"/>
                                    </div>
                                    <div>
                                        <span>Employees reviewed</span>
                                        <field name="review_progress" widget="progressbar" nolabel="1" readonly="1"/>
                                    </div>
                                    <div>
                                        <span>Payslips ready</span>
                                        <field name="payslip_progress" widget="progressbar" nolabel="1" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_current_run" type="object" string="Open Payroll" class="btn-primary" invisible="not has_current_run"/>
                                <button name="action_select_payroll" type="object" string="Select Another" class="btn-secondary"/>
                                <button name="action_create_payroll_run" type="object" string="Create Payroll" class="btn-primary" invisible="has_current_run" groups="spx_tt_payroll.group_tt_payroll_officer"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_attention">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-exclamation-circle"/></div>
                                <div>
                                    <h3>Items Needing Attention</h3>
                                    <span>Prioritized problems and useful information</span>
                                </div>
                            </div>
                            <div class="o_tt_alert_summary">
                                <div class="o_tt_alert_level o_tt_alert_critical">
                                    <span>Critical</span>
                                    <strong><field name="critical_alert_count" nolabel="1" readonly="1"/></strong>
                                </div>
                                <div class="o_tt_alert_level o_tt_alert_warning">
                                    <span>Attention</span>
                                    <strong><field name="warning_alert_count" nolabel="1" readonly="1"/></strong>
                                </div>
                                <div class="o_tt_alert_level o_tt_alert_info">
                                    <span>Information</span>
                                    <strong><field name="information_alert_count" nolabel="1" readonly="1"/></strong>
                                </div>
                            </div>
                            <div class="o_tt_card_metric"><field name="attention_count" nolabel="1" readonly="1"/> employees blocked</div>
                            <div class="o_tt_click_rows">
                                <div class="o_tt_metric_row" invisible="not has_current_run">
                                    <span><strong><field name="missing_checkout_count" nolabel="1" readonly="1"/></strong> Missing check-outs</span>
                                    <button name="action_open_missing_checkouts" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                                <div class="o_tt_metric_row" invisible="not has_current_run">
                                    <span><strong><field name="pending_time_off_count" nolabel="1" readonly="1"/></strong> Pending Time Off</span>
                                    <button name="action_open_pending_time_off" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                                <div class="o_tt_metric_row">
                                    <span><strong><field name="employee_needs_setup_count" nolabel="1" readonly="1"/></strong> Employees need setup</span>
                                    <button name="action_open_employee_setup" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_attention_items" type="object" string="Review All Items" class="btn-primary" invisible="not has_current_run"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_employees">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-users"/></div>
                                <div>
                                    <h3>Employees</h3>
                                    <span>Payroll enrolment and setup</span>
                                </div>
                            </div>
                            <div class="o_tt_card_metric"><field name="employee_count" nolabel="1" readonly="1"/></div>
                            <div class="o_tt_click_rows">
                                <div class="o_tt_metric_row">
                                    <span><strong><field name="employee_complete_count" nolabel="1" readonly="1"/></strong> Setup complete</span>
                                    <button name="action_open_complete_employees" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                                <div class="o_tt_metric_row">
                                    <span><strong><field name="employee_needs_setup_count" nolabel="1" readonly="1"/></strong> Need attention</span>
                                    <button name="action_open_employee_setup" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                                <div class="o_tt_metric_row">
                                    <span><strong><field name="employee_on_hold_count" nolabel="1" readonly="1"/></strong> On hold</span>
                                    <button name="action_open_on_hold_employees" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                                <div class="o_tt_metric_row">
                                    <span><strong><field name="employee_excluded_count" nolabel="1" readonly="1"/></strong> Excluded</span>
                                    <button name="action_open_excluded_employees" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_employees" type="object" string="View Employees" class="btn-primary"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_attendance">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-clock-o"/></div>
                                <div>
                                    <h3>Attendance &amp; Time Off</h3>
                                    <span>Hours used by the selected payroll</span>
                                </div>
                            </div>
                            <div class="o_tt_dashboard_kpis">
                                <div><span>Expected</span><strong><field name="expected_hours" nolabel="1" readonly="1"/> hrs</strong></div>
                                <div><span>Clocked</span><strong><field name="clocked_hours" nolabel="1" readonly="1"/> hrs</strong></div>
                                <div><span>Payable</span><strong><field name="payable_hours" nolabel="1" readonly="1"/> hrs</strong></div>
                            </div>
                            <div class="o_tt_card_stats">
                                <span><strong><field name="attendance_confirmed_count" nolabel="1" readonly="1"/></strong> attendance confirmed</span>
                                <span><strong><field name="paid_leave_hours" nolabel="1" readonly="1"/></strong> paid leave hours</span>
                                <span><strong><field name="unpaid_leave_hours" nolabel="1" readonly="1"/></strong> unpaid leave hours</span>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_attendance" type="object" string="Attendances" class="btn-primary" invisible="not has_current_run"/>
                                <button name="action_open_time_off" type="object" string="Time Off" class="btn-secondary" invisible="not has_current_run"/>
                                <button name="action_open_all_calculations" type="object" string="Payroll Hours" class="btn-secondary" invisible="not has_current_run"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_statutory">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-university"/></div>
                                <div>
                                    <h3>PAYE, NIS &amp; Health Surcharge</h3>
                                    <span>Employee deductions plus Employer NIS</span>
                                </div>
                            </div>
                            <div class="o_tt_card_metric o_tt_money"><field name="total_statutory_liability" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></div>
                            <div class="o_tt_card_stats o_tt_statutory_rows">
                                <span>PAYE <strong><field name="paye_total" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></span>
                                <span>Employee NIS <strong><field name="employee_nis_total" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></span>
                                <span>Health Surcharge <strong><field name="health_surcharge_total" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></span>
                                <span>Employer NIS <strong><field name="employer_nis_total" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></span>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_statutory_breakdown" type="object" string="View Breakdown" class="btn-primary" invisible="not has_current_run"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_cost">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-line-chart"/></div>
                                <div>
                                    <h3>Payroll Cost</h3>
                                    <span>Total cost to the company</span>
                                </div>
                            </div>
                            <div class="o_tt_card_metric o_tt_money"><field name="total_company_cost" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></div>
                            <div class="o_tt_dashboard_kpis o_tt_cost_kpis">
                                <div><span>Wages</span><strong><field name="wages_total" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></div>
                                <div><span>Additions</span><strong><field name="additions_total" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></div>
                                <div><span>Employer Contributions</span><strong><field name="employer_contributions" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></div>
                            </div>
                            <div class="o_tt_cost_summary">
                                <span>Gross <strong><field name="gross_pay" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></span>
                                <span>Net <strong><field name="net_pay" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></strong></span>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_current_run" type="object" string="Open Cost Details" class="btn-primary" invisible="not has_current_run"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_payments">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-bank"/></div>
                                <div>
                                    <h3>Payments</h3>
                                    <span>Total net pay across all payment methods</span>
                                </div>
                            </div>
                            <div class="o_tt_card_metric o_tt_money"><field name="net_pay" widget="monetary" nolabel="1" readonly="1" options="{'currency_field': 'currency_id'}"/></div>
                            <div class="o_tt_card_stats">
                                <span><strong><field name="bank_employee_count" nolabel="1" readonly="1"/></strong> bank transfers</span>
                                <span><strong><field name="cash_employee_count" nolabel="1" readonly="1"/></strong> cash</span>
                                <span><strong><field name="cheque_employee_count" nolabel="1" readonly="1"/></strong> cheque</span>
                            </div>
                            <div class="o_tt_metric_row o_tt_warning_text" invisible="not has_current_run">
                                <span><strong><field name="missing_bank_count" nolabel="1" readonly="1"/></strong> Missing bank details</span>
                                <button name="action_open_missing_bank" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_payments" type="object" string="Payment List" class="btn-primary" invisible="not has_current_run"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_payslips">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-file-text-o"/></div>
                                <div>
                                    <h3>Payslips</h3>
                                    <span>Employee payroll documents</span>
                                </div>
                            </div>
                            <div class="o_tt_card_metric"><field name="payslip_count" nolabel="1" readonly="1"/></div>
                            <div class="o_tt_click_rows">
                                <div class="o_tt_metric_row" invisible="not has_current_run">
                                    <span><strong><field name="payslip_ready_count" nolabel="1" readonly="1"/></strong> Ready</span>
                                    <button name="action_open_ready_payslips" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                                <div class="o_tt_metric_row" invisible="not has_current_run">
                                    <span><strong><field name="payslip_pending_count" nolabel="1" readonly="1"/></strong> Pending</span>
                                    <button name="action_open_pending_payslips" type="object" string="Open" class="btn-link o_tt_metric_link"/>
                                </div>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_print_payslips" type="object" string="Print Payslips" class="btn-primary" invisible="not has_current_run"/>
                            </div>
                        </section>

                        <section class="o_tt_dashboard_card o_tt_card_reports">
                            <div class="o_tt_card_header">
                                <div class="o_tt_card_icon"><i class="fa fa-bar-chart"/></div>
                                <div>
                                    <h3>Reports &amp; Configuration</h3>
                                    <span>Payroll review and quick access</span>
                                </div>
                            </div>
                            <div class="o_tt_report_links">
                                <button name="action_open_payroll_runs" type="object" string="Payroll Register" class="btn-link" icon="fa-table"/>
                                <button name="action_open_statutory_breakdown" type="object" string="Statutory Breakdown" class="btn-link" icon="fa-calculator" invisible="not has_current_run"/>
                                <button name="action_open_settings" type="object" string="Payroll Settings" class="btn-link" icon="fa-cog" groups="spx_tt_payroll.group_tt_payroll_manager"/>
                            </div>
                            <div class="o_tt_card_actions">
                                <button name="action_open_payroll_runs" type="object" string="View Reports" class="btn-primary"/>
                            </div>
                        </section>
                    </div>

                    <section class="o_tt_dashboard_trend">
                        <div class="o_tt_recent_runs_header">
                            <div>
                                <h2>Payroll Cost Trend</h2>
                                <p>Total company cost across the latest six non-cancelled payroll runs.</p>
                            </div>
                            <button name="action_open_payroll_runs" type="object" string="View Payroll History" class="btn-secondary"/>
                        </div>
                        <field name="payroll_trend_html" widget="html" nolabel="1" readonly="1"/>
                    </section>

                    <section class="o_tt_recent_runs">
                        <div class="o_tt_recent_runs_header">
                            <div>
                                <h2>Recent Payroll Runs</h2>
                                <p>Cancelled payrolls are hidden here but remain available through View All.</p>
                            </div>
                            <button name="action_open_payroll_runs" type="object" string="View All" class="btn-secondary"/>
                        </div>
                        <field name="recent_run_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0"
                                  decoration-info="state == 'draft'"
                                  decoration-warning="state in ('attendance_review', 'under_review')"
                                  decoration-success="state in ('approved', 'paid')">
                                <field name="name"/>
                                <field name="pay_frequency_id"/>
                                <field name="payment_date"/>
                                <field name="employee_count"/>
                                <field name="needs_attention_count"/>
                                <field name="reviewed_count"/>
                                <field name="gross_pay"/>
                                <field name="employer_contributions"/>
                                <field name="total_company_cost"/>
                                <field name="net_pay"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </section>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tt_payroll_dashboard_server" model="ir.actions.server">
        <field name="name">Payroll Dashboard</field>
        <field name="model_id" ref="model_spx_tt_payroll_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>
</odoo>
