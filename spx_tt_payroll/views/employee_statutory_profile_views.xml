<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_employee_statutory_profile_form" model="ir.ui.view">
        <field name="name">spx.tt.employee.statutory.profile.form</field>
        <field name="model">spx.tt.employee.statutory.profile</field>
        <field name="arch" type="xml">
            <form string="PAYE and Statutory Settings" create="0" delete="0">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="employee_id" readonly="1"/></h1>
                        <p class="text-muted">These values are used by the automatic PAYE, NIS, and Health Surcharge calculations.</p>
                    </div>
                    <group>
                        <group string="PAYE and TD1">
                            <field name="resident"/>
                            <field name="paye_exempt"/>
                            <field name="td1_approved"/>
                            <field name="td1_effective_date" invisible="not td1_approved"/>
                            <field name="td1_expiry_date" invisible="not td1_approved"/>
                            <field name="personal_allowance_override" widget="monetary"/>
                            <field name="approved_pension_annuity_annual" widget="monetary"/>
                            <field name="approved_other_deductions_annual" widget="monetary"/>
                            <field name="approved_tax_credits_annual" widget="monetary"/>
                        </group>
                        <group string="NIS and Health Surcharge">
                            <field name="retirement_pension_recipient"/>
                            <field name="pension_only_income"/>
                            <div class="text-muted">
                                Employees under 16 or aged 65 and over are automatically treated as Class Z for NIS. Employees under 16 or aged 60 and over are automatically exempt from Health Surcharge.
                            </div>
                        </group>
                    </group>
                    <group string="Opening Year-to-Date Balances">
                        <group>
                            <field name="opening_ytd_year"/>
                            <field name="opening_period_count"/>
                            <field name="opening_taxable_earnings" widget="monetary"/>
                        </group>
                        <group>
                            <field name="opening_paye" widget="monetary"/>
                            <field name="opening_employee_nis" widget="monetary"/>
                            <field name="opening_health_surcharge" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Opening Payslip Summary Balances">
                        <group>
                            <field name="opening_income" widget="monetary"/>
                            <field name="opening_additions" widget="monetary"/>
                            <field name="opening_gross" widget="monetary"/>
                        </group>
                        <group>
                            <field name="opening_other_deductions" widget="monetary"/>
                            <field name="opening_loans" widget="monetary"/>
                            <field name="opening_net" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tt_employee_statutory_profile" model="ir.actions.act_window">
        <field name="name">PAYE and Statutory Settings</field>
        <field name="res_model">spx.tt.employee.statutory.profile</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tt_employee_statutory_profile_form"/>
        <field name="target">current</field>
    </record>
</odoo>
