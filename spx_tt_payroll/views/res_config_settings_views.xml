<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Disable the legacy inherited global Settings panel. Keeping the same
         XML ID makes this an upgrade-safe replacement for older releases. -->
    <record id="res_config_settings_view_form_tt_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.trinidad.payroll.legacy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div name="tt_payroll_legacy_settings_placeholder" class="d-none"/>
            </xpath>
        </field>
    </record>

    <record id="view_tt_payroll_company_settings_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.company.settings.form</field>
        <field name="model">spx.tt.payroll.company.settings</field>
        <field name="arch" type="xml">
            <form string="Trinidad Payroll Settings" create="1" delete="0">
                <header>
                    <button name="action_apply"
                            type="object"
                            string="Save Settings"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Trinidad Payroll Settings</h1>
                        <p class="text-muted">
                            These are company defaults. Employee and payroll-run values can still be changed where applicable.
                        </p>
                    </div>

                    <group>
                        <group string="Company">
                            <field name="company_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="payroll_enabled"/>
                            <field name="default_frequency_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Default Working Hours">
                            <field name="default_hours_per_day"/>
                            <field name="default_hours_per_week"/>
                        </group>
                    </group>

                    <group string="Review and Approval">
                        <group>
                            <field name="require_review"/>
                            <field name="require_approval"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                Small businesses may allow one payroll manager to prepare and approve payroll. Larger companies can keep review and approval as separate steps.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tt_payroll_settings" model="ir.actions.act_window">
        <field name="name">Payroll Settings</field>
        <field name="res_model">spx.tt.payroll.company.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tt_payroll_company_settings_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
</odoo>
