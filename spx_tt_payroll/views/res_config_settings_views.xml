<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tt_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.trinidad.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Trinidad Payroll" name="spx_tt_payroll" groups="spx_tt_payroll.group_tt_payroll_manager">
                    <block title="Payroll Defaults" name="tt_payroll_defaults">
                        <setting string="Enable Trinidad Payroll" help="Make Trinidad payroll available for this company.">
                            <field name="tt_payroll_enabled"/>
                        </setting>
                        <setting string="Default pay frequency" help="Used as a suggestion for new payroll employees and can be changed per employee or payroll group.">
                            <field name="tt_payroll_default_frequency_id"/>
                        </setting>
                        <setting string="Default working hours" help="Used as a starting value and can be changed for each payroll group or employee.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="tt_payroll_default_hours_per_day" class="col-lg-4 o_light_label" string="Hours per day"/>
                                    <field name="tt_payroll_default_hours_per_day" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="tt_payroll_default_hours_per_week" class="col-lg-4 o_light_label" string="Hours per week"/>
                                    <field name="tt_payroll_default_hours_per_week" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Review and Approval" name="tt_payroll_approvals">
                        <setting string="Require payroll review" help="Keeps the review step available when payroll runs are added in a later phase.">
                            <field name="tt_payroll_require_review"/>
                        </setting>
                        <setting string="Require payroll approval" help="Keeps the approval step available when payroll runs are added in a later phase.">
                            <field name="tt_payroll_require_approval"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_tt_payroll_settings" model="ir.actions.act_window">
        <field name="name">Payroll Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'spx_tt_payroll'}</field>
    </record>
</odoo>
