<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.trinidad.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Payroll" name="tt_payroll" groups="spx_tt_payroll.group_tt_payroll_user">
                    <group>
                        <group string="Payroll Status">
                            <field name="tt_payroll_enabled"/>
                            <field name="tt_payroll_status" invisible="not tt_payroll_enabled"/>
                            <field name="tt_payroll_group_id" invisible="not tt_payroll_enabled"/>
                            <field name="tt_pay_frequency_id" invisible="not tt_payroll_enabled"/>
                            <field name="tt_payroll_start_date" invisible="not tt_payroll_enabled"/>
                            <field name="tt_payroll_end_date" invisible="not tt_payroll_enabled"/>
                        </group>
                        <group string="Pay Details" invisible="not tt_payroll_enabled">
                            <field name="tt_currency_id" invisible="1"/>
                            <field name="tt_pay_type"/>
                            <field name="tt_monthly_salary" invisible="tt_pay_type != 'monthly'"/>
                            <field name="tt_weekly_salary" invisible="tt_pay_type != 'weekly'"/>
                            <field name="tt_daily_rate" invisible="tt_pay_type != 'daily'"/>
                            <field name="tt_hourly_rate" invisible="tt_pay_type != 'hourly'"/>
                            <field name="tt_normal_hours_per_day"/>
                            <field name="tt_normal_hours_per_week"/>
                        </group>
                    </group>

                    <group string="Statutory Information" invisible="not tt_payroll_enabled">
                        <group>
                            <field name="tt_bir_number"/>
                            <field name="tt_nis_number" invisible="tt_nis_exempt"/>
                            <field name="tt_nis_exempt"/>
                        </group>
                        <group>
                            <field name="tt_health_surcharge_exempt"/>
                            <field name="tt_statutory_exemption_reason"
                                   invisible="not tt_nis_exempt and not tt_health_surcharge_exempt"/>
                        </group>
                    </group>

                    <group string="Payment Method" invisible="not tt_payroll_enabled">
                        <group>
                            <field name="tt_payment_method"/>
                            <field name="tt_bank_name" invisible="tt_payment_method != 'bank'"/>
                            <field name="tt_bank_branch" invisible="tt_payment_method != 'bank'"/>
                        </group>
                        <group invisible="tt_payment_method != 'bank'">
                            <field name="tt_bank_account_name"/>
                            <field name="tt_bank_account_number" password="True"/>
                            <field name="tt_bank_account_type"/>
                        </group>
                    </group>

                    <group string="Payroll Readiness" invisible="not tt_payroll_enabled">
                        <group>
                            <field name="tt_payroll_readiness_state" widget="badge"
                                   decoration-success="tt_payroll_readiness_state == 'ready'"
                                   decoration-warning="tt_payroll_readiness_state == 'incomplete'"/>
                            <field name="tt_payroll_issue_count"/>
                        </group>
                        <group>
                            <field name="tt_payroll_issue_summary" nolabel="1" readonly="1"/>
                        </group>
                    </group>

                    <group string="Recurring Earnings and Deductions" invisible="not tt_payroll_enabled">
                        <field name="tt_recurring_pay_item_ids" nolabel="1" context="{'default_employee_id': id}">
                            <list editable="bottom">
                                <field name="company_id" column_invisible="True"/>
                                <field name="pay_item_id"/>
                                <field name="category" widget="badge" readonly="1"/>
                                <field name="calculation_method" column_invisible="True"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="amount" invisible="calculation_method not in ['fixed', 'manual']"/>
                                <field name="percentage" invisible="calculation_method != 'percentage'"/>
                                <field name="quantity" invisible="calculation_method != 'hours'"/>
                                <field name="start_date" optional="show"/>
                                <field name="end_date" optional="show"/>
                                <field name="active" optional="hide"/>
                                <field name="note" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_tt_payroll_employee_list" model="ir.ui.view">
        <field name="name">hr.employee.list.trinidad.payroll</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Payroll Employees" multi_edit="1"
                  decoration-success="tt_payroll_readiness_state == 'ready'"
                  decoration-warning="tt_payroll_readiness_state == 'incomplete'">
                <field name="name"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="tt_payroll_enabled" optional="hide"/>
                <field name="tt_payroll_status" widget="badge"/>
                <field name="tt_pay_type"/>
                <field name="tt_pay_frequency_id"/>
                <field name="tt_payroll_group_id" optional="show"/>
                <field name="tt_payroll_readiness_state" widget="badge"/>
                <field name="tt_payroll_issue_count" string="Missing Items" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tt_payroll_employee_search" model="ir.ui.view">
        <field name="name">hr.employee.search.trinidad.payroll</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Payroll Employees">
                <field name="name"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="tt_payroll_group_id"/>
                <field name="tt_pay_frequency_id"/>
                <filter name="included" string="Included in Payroll" domain="[('tt_payroll_enabled', '=', True)]"/>
                <filter name="active_payroll" string="Payroll Active" domain="[('tt_payroll_status', '=', 'active')]"/>
                <filter name="on_hold" string="On Hold" domain="[('tt_payroll_status', '=', 'on_hold')]"/>
                <filter name="ready" string="Ready" domain="[('tt_payroll_enabled', '=', True), ('tt_payroll_issue_count', '=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Payroll Group" name="group_payroll" context="{'group_by': 'tt_payroll_group_id'}"/>
                    <filter string="Pay Frequency" name="group_frequency" context="{'group_by': 'tt_pay_frequency_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tt_payroll_employees" model="ir.actions.act_window">
        <field name="name">Payroll Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tt_payroll_employee_list"/>
        <field name="search_view_id" ref="view_tt_payroll_employee_search"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'search_default_included': 1, 'default_tt_payroll_enabled': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an employee to Trinidad Payroll</p>
            <p>Open an employee and complete the Payroll tab. The readiness review will show anything still missing.</p>
        </field>
    </record>
</odoo>
