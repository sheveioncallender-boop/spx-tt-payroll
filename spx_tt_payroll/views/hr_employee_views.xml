<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payroll information lives on Odoo's normal hr.employee record. -->
    <record id="view_employee_form_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.trinidad.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Payroll" name="tt_payroll" groups="spx_tt_payroll.group_tt_payroll_user">
                    <div class="alert alert-info" role="alert">
                        This is the employee's normal Odoo record. Payroll uses the employee's
                        Odoo work schedule and Odoo Attendance check-ins and check-outs; it does
                        not create a separate employee or attendance record.
                    </div>

                    <group>
                        <group string="Payroll Status">
                            <field name="tt_payroll_status"/>
                            <field name="tt_payroll_group_id" invisible="tt_payroll_status == 'excluded'"/>
                            <field name="tt_pay_frequency_id" invisible="tt_payroll_status == 'excluded'"/>
                            <field name="tt_payroll_start_date" invisible="tt_payroll_status == 'excluded'"/>
                            <field name="tt_payroll_end_date" invisible="tt_payroll_status == 'excluded'"/>
                        </group>
                        <group string="Pay Details" invisible="tt_payroll_status == 'excluded'">
                            <field name="tt_currency_id" invisible="1"/>
                            <field name="tt_pay_type"/>
                            <field name="tt_monthly_salary" invisible="tt_pay_type != 'monthly'"/>
                            <field name="tt_weekly_salary" invisible="tt_pay_type != 'weekly'"/>
                            <field name="tt_daily_rate" invisible="tt_pay_type != 'daily'"/>
                            <field name="tt_hourly_rate" invisible="tt_pay_type != 'hourly'"/>
                            <field name="tt_normal_hours_per_day"/>
                            <field name="tt_normal_hours_per_week"/>
                        </group>
                    </group>

                    <group string="Attendance and Work Schedule" invisible="tt_payroll_status == 'excluded'">
                        <group>
                            <field name="resource_calendar_id" string="Work Schedule"/>
                            <field name="attendance_manager_id" string="Attendance Approver" widget="many2one_avatar_user"/>
                            <field name="ruleset_id" string="Overtime Ruleset"/>
                        </group>
                        <group>
                            <p class="text-muted">
                                The work schedule provides expected hours. Actual hours will be read
                                from Odoo Attendances during the payroll run.
                            </p>
                            <button name="action_tt_open_attendances"
                                    type="object"
                                    string="Open Odoo Attendances"
                                    icon="fa-clock-o"
                                    class="btn btn-secondary"
                                    groups="spx_tt_payroll.group_tt_payroll_officer"/>
                        </group>
                    </group>

                    <group string="Statutory Information" invisible="tt_payroll_status == 'excluded'">
                        <group>
                            <field name="tt_bir_number"/>
                            <field name="tt_nis_number" invisible="tt_nis_exempt"/>
                            <field name="tt_nis_exempt"/>
                        </group>
                        <group>
                            <field name="tt_health_surcharge_exempt"/>
                            <field name="tt_statutory_exemption_reason"
                                   invisible="not tt_nis_exempt and not tt_health_surcharge_exempt"/>
                        </group>
                    </group>

                    <group string="Payment Method" invisible="tt_payroll_status == 'excluded'">
                        <group>
                            <field name="tt_payment_method"/>
                            <field name="tt_bank_name" invisible="tt_payment_method != 'bank'"/>
                            <field name="tt_bank_branch" invisible="tt_payment_method != 'bank'"/>
                        </group>
                        <group invisible="tt_payment_method != 'bank'">
                            <field name="tt_bank_account_name"/>
                            <field name="tt_bank_account_number" password="True"/>
                            <field name="tt_bank_account_type"/>
                        </group>
                    </group>

                    <group string="Payroll Readiness" invisible="tt_payroll_status == 'excluded'">
                        <group>
                            <field name="tt_payroll_readiness_state" widget="badge"
                                   decoration-success="tt_payroll_readiness_state == 'ready'"
                                   decoration-warning="tt_payroll_readiness_state == 'incomplete'"/>
                            <field name="tt_payroll_issue_count"/>
                        </group>
                        <group>
                            <field name="tt_payroll_issue_summary" nolabel="1" readonly="1"/>
                        </group>
                    </group>

                    <group string="Recurring Earnings and Deductions" invisible="tt_payroll_status == 'excluded'">
                        <field name="tt_recurring_pay_item_ids" nolabel="1" context="{'default_employee_id': id}">
                            <list editable="bottom">
                                <field name="company_id" column_invisible="True"/>
                                <field name="pay_item_id"/>
                                <field name="category" widget="badge" readonly="1"/>
                                <field name="calculation_method" column_invisible="True"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="amount" invisible="calculation_method not in ['fixed', 'manual']"/>
                                <field name="percentage" invisible="calculation_method != 'percentage'"/>
                                <field name="quantity" invisible="calculation_method != 'hours'"/>
                                <field name="start_date" optional="show"/>
                                <field name="end_date" optional="show"/>
                                <field name="active" optional="hide"/>
                                <field name="note" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add optional payroll columns to Odoo's standard Employees list. -->
    <record id="view_employee_tree_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.list.trinidad.payroll.fields</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="tt_payroll_status" widget="badge" optional="hide"
                       groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_pay_type" optional="hide"
                       groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_pay_frequency_id" optional="hide"
                       groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_payroll_group_id" optional="hide"
                       groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_payroll_readiness_state" widget="badge" optional="hide"
                       groups="spx_tt_payroll.group_tt_payroll_user"/>
            </xpath>
        </field>
    </record>

    <!-- Add payroll filters to Odoo's standard Employees search view. -->
    <record id="view_employee_search_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.search.trinidad.payroll.filters</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="tt_payroll_group_id" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_pay_frequency_id" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <separator groups="spx_tt_payroll.group_tt_payroll_user"/>
                <filter name="tt_payroll_active" string="Payroll Active"
                        domain="[('tt_payroll_status', '=', 'active')]"
                        groups="spx_tt_payroll.group_tt_payroll_user"/>
                <filter name="tt_payroll_on_hold" string="Payroll On Hold"
                        domain="[('tt_payroll_status', '=', 'on_hold')]"
                        groups="spx_tt_payroll.group_tt_payroll_user"/>
                <filter name="tt_payroll_excluded" string="Excluded from Payroll"
                        domain="[('tt_payroll_status', '=', 'excluded')]"
                        groups="spx_tt_payroll.group_tt_payroll_user"/>
                <filter name="tt_payroll_ready" string="Payroll Ready"
                        domain="[('tt_payroll_status', '!=', 'excluded'), ('tt_payroll_issue_count', '=', 0)]"
                        groups="spx_tt_payroll.group_tt_payroll_user"/>
                <group groups="spx_tt_payroll.group_tt_payroll_user">
                    <filter string="Payroll Group" name="group_tt_payroll"
                            context="{'group_by': 'tt_payroll_group_id'}"/>
                    <filter string="Pay Frequency" name="group_tt_frequency"
                            context="{'group_by': 'tt_pay_frequency_id'}"/>
                    <filter string="Payroll Status" name="group_tt_status"
                            context="{'group_by': 'tt_payroll_status'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Legacy Phase 1 views are disabled on upgrade; payroll now uses Odoo's views. -->
    <record id="view_tt_payroll_employee_list" model="ir.ui.view">
        <field name="name">hr.employee.list.trinidad.payroll.legacy</field>
        <field name="model">hr.employee</field>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_tt_payroll_employee_search" model="ir.ui.view">
        <field name="name">hr.employee.search.trinidad.payroll.legacy</field>
        <field name="model">hr.employee</field>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_tt_payroll_employees" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'chat_icon': True, 'searchpanel_default_company_id': allowed_company_ids[0]}</field>
    </record>
</odoo>
