<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep the normal Odoo employee record clean while providing a direct link
         to the dedicated payroll workspace. -->
    <record id="view_employee_form_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.trinidad.payroll.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_tt_open_payroll_profile"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        string="TT Payroll"
                        groups="spx_tt_payroll.group_tt_payroll_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_tt_payroll_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.trinidad.payroll.workspace</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form string="TT Payroll Employee" class="o_tt_payroll_employee_form">
                <header>
                    <field name="tt_payroll_status"
                           widget="statusbar"
                           statusbar_visible="active,on_hold,excluded"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="tt_currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="allowed_country_state_ids" invisible="1"/>
                    <field name="address_id" invisible="1"/>
                    <field name="work_contact_id" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_tt_open_attendances"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clock-o"
                                groups="spx_tt_payroll.group_tt_payroll_officer">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Attendances</span>
                            </div>
                        </button>
                        <button name="action_tt_open_full_employee_record"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Full Employee Record</span>
                            </div>
                        </button>
                    </div>

                    <div class="o_tt_payroll_profile_header">
                        <field name="image_1920"
                               widget="image"
                               class="oe_avatar o_tt_payroll_avatar"
                               options="{'preview_image': 'image_128'}"/>
                        <div class="o_tt_payroll_profile_identity">
                            <h1>
                                <field name="name" placeholder="Employee Name"/>
                            </h1>
                            <div class="o_tt_payroll_profile_line">
                                <field name="tt_employee_number" nolabel="1" placeholder="Employee Number" class="oe_inline"/>
                                <span class="text-muted">•</span>
                                <field name="job_id" nolabel="1" placeholder="Job Position" class="oe_inline"/>
                                <span class="text-muted">•</span>
                                <field name="department_id" nolabel="1" placeholder="Department" class="oe_inline"/>
                            </div>
                            <div class="o_tt_payroll_profile_line text-muted">
                                <field name="work_email" nolabel="1" placeholder="Work Email" class="oe_inline"/>
                                <field name="work_phone" nolabel="1" placeholder="Work Phone" class="oe_inline"/>
                            </div>
                        </div>
                        <div class="o_tt_payroll_setup_panel">
                            <span class="o_tt_payroll_caption">Setup Status</span>
                            <field name="tt_payroll_readiness_state"
                                   nolabel="1"
                                   widget="badge"
                                   decoration-success="tt_payroll_readiness_state == 'ready'"
                                   decoration-warning="tt_payroll_readiness_state == 'incomplete'"
                                   decoration-muted="tt_payroll_readiness_state == 'not_enrolled'"/>
                            <field name="tt_payroll_issue_count" invisible="1"/>
                        </div>
                    </div>

                    <div class="o_tt_payroll_summary_grid" invisible="tt_payroll_status == 'excluded'">
                        <div class="o_tt_payroll_summary_card">
                            <span class="o_tt_payroll_caption">Base Pay</span>
                            <div class="o_tt_payroll_summary_value">
                                <field name="tt_current_pay_amount" nolabel="1" readonly="1"/>
                            </div>
                            <field name="tt_current_pay_unit" nolabel="1" readonly="1" class="text-muted"/>
                        </div>
                        <div class="o_tt_payroll_summary_card">
                            <span class="o_tt_payroll_caption">Pay Frequency</span>
                            <div class="o_tt_payroll_summary_value">
                                <field name="tt_pay_frequency_id" nolabel="1"/>
                            </div>
                        </div>
                        <div class="o_tt_payroll_summary_card">
                            <span class="o_tt_payroll_caption">Payroll Group</span>
                            <div class="o_tt_payroll_summary_value">
                                <field name="tt_payroll_group_id" nolabel="1"/>
                            </div>
                        </div>
                        <div class="o_tt_payroll_summary_card">
                            <span class="o_tt_payroll_caption">Payment Method</span>
                            <div class="o_tt_payroll_summary_value">
                                <field name="tt_payment_method" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <notebook invisible="tt_payroll_status == 'excluded'">
                        <page string="Overview" name="tt_overview">
                            <group>
                                <group string="Employment">
                                    <field name="tt_employee_number"/>
                                    <field name="tt_employment_type"/>
                                    <field name="tt_hire_date"/>
                                    <field name="tt_probation_end_date"/>
                                    <field name="tt_confirmation_date"/>
                                    <field name="tt_termination_date"/>
                                </group>
                                <group string="Organization">
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                    <field name="parent_id" string="Manager"/>
                                    <field name="work_location_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                            <group string="Contact Information">
                                <group>
                                    <field name="work_email"/>
                                    <field name="work_phone"/>
                                    <field name="mobile_phone"/>
                                </group>
                                <group>
                                    <field name="private_email"/>
                                    <field name="private_phone"/>
                                    <field name="emergency_contact"/>
                                    <field name="emergency_phone"/>
                                </group>
                            </group>
                        </page>

                        <page string="Personal" name="tt_personal">
                            <group>
                                <group string="Personal Details">
                                    <field name="legal_name"/>
                                    <field name="identification_id"/>
                                    <field name="birthday"/>
                                    <field name="sex" string="Gender"/>
                                    <field name="marital"/>
                                    <field name="country_id" string="Nationality"/>
                                </group>
                                <group string="Private Address">
                                    <field name="private_street"/>
                                    <field name="private_street2"/>
                                    <field name="private_city"/>
                                    <field name="private_state_id"/>
                                    <field name="private_zip"/>
                                    <field name="private_country_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Pay Details" name="tt_pay_details">
                            <group>
                                <group string="Pay Setup">
                                    <field name="tt_pay_type"/>
                                    <field name="tt_pay_frequency_id"/>
                                    <field name="tt_payroll_group_id"/>
                                    <field name="tt_pay_effective_date"/>
                                    <field name="tt_payment_currency_id"/>
                                </group>
                                <group string="Base Pay">
                                    <field name="tt_monthly_salary" invisible="tt_pay_type != 'monthly'"/>
                                    <field name="tt_weekly_salary" invisible="tt_pay_type != 'weekly'"/>
                                    <field name="tt_daily_rate" invisible="tt_pay_type != 'daily'"/>
                                    <field name="tt_hourly_rate" invisible="tt_pay_type != 'hourly'"/>
                                    <field name="tt_current_pay_amount" readonly="1"/>
                                    <field name="tt_current_pay_unit" readonly="1"/>
                                </group>
                            </group>
                            <group string="Normal Working Time">
                                <group>
                                    <field name="tt_normal_hours_per_day"/>
                                    <field name="tt_normal_hours_per_week"/>
                                </group>
                                <group>
                                    <field name="resource_calendar_id" string="Work Schedule"/>
                                    <field name="ruleset_id" string="Overtime Ruleset" groups="hr.group_hr_manager"/>
                                </group>
                            </group>
                        </page>

                        <page string="Statutory" name="tt_statutory">
                            <group>
                                <group string="Tax Information">
                                    <field name="tt_bir_number"/>
                                    <field name="tt_td1_on_file"/>
                                    <field name="tt_td1_effective_date" invisible="not tt_td1_on_file"/>
                                    <field name="tt_td1_reference" invisible="not tt_td1_on_file"/>
                                </group>
                                <group string="NIS and Health Surcharge">
                                    <field name="tt_nis_number" invisible="tt_nis_exempt"/>
                                    <field name="tt_nis_exempt"/>
                                    <field name="tt_health_surcharge_exempt"/>
                                    <field name="tt_statutory_exemption_reason"
                                           invisible="not tt_nis_exempt and not tt_health_surcharge_exempt"/>
                                </group>
                            </group>
                        </page>

                        <page string="Earnings" name="tt_earnings">
                            <field name="tt_recurring_earning_ids"
                                   nolabel="1"
                                   context="{'default_employee_id': id}">
                                <list editable="bottom">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="pay_item_id"
                                           domain="[('category', '=', 'earning'), ('recurring_allowed', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="calculation_method" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount" invisible="calculation_method not in ['fixed', 'manual']"/>
                                    <field name="percentage" invisible="calculation_method != 'percentage'"/>
                                    <field name="quantity" invisible="calculation_method != 'hours'"/>
                                    <field name="start_date" optional="show"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="show_on_payslip" optional="hide"/>
                                    <field name="active" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Deductions" name="tt_deductions">
                            <field name="tt_recurring_deduction_ids"
                                   nolabel="1"
                                   context="{'default_employee_id': id}">
                                <list editable="bottom">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="pay_item_id"
                                           domain="[('category', '=', 'deduction'), ('recurring_allowed', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="calculation_method" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="reference" optional="show"/>
                                    <field name="amount" invisible="calculation_method not in ['fixed', 'manual']"/>
                                    <field name="percentage" invisible="calculation_method != 'percentage'"/>
                                    <field name="original_balance" optional="hide"/>
                                    <field name="remaining_balance" optional="show"/>
                                    <field name="start_date" optional="show"/>
                                    <field name="end_date" optional="show"/>
                                    <field name="show_on_payslip" optional="hide"/>
                                    <field name="active" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Banking" name="tt_banking">
                            <group>
                                <group string="Payment Setup">
                                    <field name="tt_payment_method"/>
                                    <field name="tt_payment_currency_id"/>
                                    <field name="tt_bank_reference" invisible="tt_payment_method != 'bank'"/>
                                    <field name="tt_include_in_bank_file" invisible="tt_payment_method != 'bank'"/>
                                </group>
                                <group string="Odoo Bank Accounts" invisible="tt_payment_method != 'bank'">
                                    <field name="bank_account_ids" widget="many2many_tags"/>
                                    <field name="primary_bank_account_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Attendance" name="tt_attendance">
                            <group>
                                <group string="Attendance Identification">
                                    <field name="barcode" string="Clock / Badge ID"/>
                                    <field name="pin" string="Attendance PIN" password="True"/>
                                </group>
                                <group string="Work Schedule">
                                    <field name="resource_calendar_id" string="Work Schedule"/>
                                    <field name="ruleset_id" string="Overtime Ruleset" groups="hr.group_hr_manager"/>
                                    <field name="tt_normal_hours_per_day"/>
                                    <field name="tt_normal_hours_per_week"/>
                                </group>
                            </group>
                            <group>
                                <button name="action_tt_open_attendances"
                                        type="object"
                                        string="View Employee Attendances"
                                        icon="fa-clock-o"
                                        class="btn-primary"
                                        groups="spx_tt_payroll.group_tt_payroll_officer"/>
                            </group>
                        </page>

                        <page string="Notes &amp; Setup" name="tt_notes_setup">
                            <group>
                                <group string="Setup Status">
                                    <field name="tt_payroll_readiness_state"
                                           widget="badge"
                                           decoration-success="tt_payroll_readiness_state == 'ready'"
                                           decoration-warning="tt_payroll_readiness_state == 'incomplete'"
                                           decoration-muted="tt_payroll_readiness_state == 'not_enrolled'"/>
                                    <field name="tt_payroll_issue_count"/>
                                    <field name="tt_payroll_issue_summary" nolabel="1" readonly="1"/>
                                </group>
                                <group string="Payroll Notes">
                                    <field name="tt_payroll_note" nolabel="1" placeholder="Internal payroll notes..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tt_payroll_employee_list" model="ir.ui.view">
        <field name="name">hr.employee.list.trinidad.payroll.workspace</field>
        <field name="model">hr.employee</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <list string="TT Payroll Employees">
                <field name="image_128" widget="image" options="{'size': [32, 32]}" optional="show"/>
                <field name="tt_employee_number" string="Employee No." optional="show"/>
                <field name="name"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="tt_payroll_status"
                       widget="badge"
                       decoration-success="tt_payroll_status == 'active'"
                       decoration-warning="tt_payroll_status == 'on_hold'"
                       decoration-muted="tt_payroll_status == 'excluded'"/>
                <field name="tt_pay_type" optional="show"/>
                <field name="tt_current_pay_amount" string="Base Pay" optional="show"/>
                <field name="tt_pay_frequency_id" optional="show"/>
                <field name="tt_payroll_group_id" optional="hide"/>
                <field name="tt_payment_method" optional="show"/>
                <field name="tt_payroll_readiness_state"
                       string="Setup"
                       widget="badge"
                       decoration-success="tt_payroll_readiness_state == 'ready'"
                       decoration-warning="tt_payroll_readiness_state == 'incomplete'"
                       decoration-muted="tt_payroll_readiness_state == 'not_enrolled'"/>
                <field name="tt_payroll_issue_count" string="Missing" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tt_payroll_employee_search" model="ir.ui.view">
        <field name="name">hr.employee.search.trinidad.payroll.workspace</field>
        <field name="model">hr.employee</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tt_employee_number"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="tt_payroll_group_id"/>
                <field name="tt_pay_frequency_id"/>
                <separator/>
                <filter name="tt_setup_incomplete"
                        string="Needs Attention"
                        domain="[('tt_payroll_readiness_state', '=', 'incomplete')]"/>
                <filter name="tt_setup_complete"
                        string="Setup Complete"
                        domain="[('tt_payroll_readiness_state', '=', 'ready')]"/>
                <filter name="tt_payroll_active"
                        string="Payroll Active"
                        domain="[('tt_payroll_status', '=', 'active')]"/>
                <filter name="tt_payroll_on_hold"
                        string="On Hold"
                        domain="[('tt_payroll_status', '=', 'on_hold')]"/>
                <filter name="tt_payroll_excluded"
                        string="Excluded"
                        domain="[('tt_payroll_status', '=', 'excluded')]"/>
                <group>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Payroll Group" name="group_payroll_group" context="{'group_by': 'tt_payroll_group_id'}"/>
                    <filter string="Pay Frequency" name="group_pay_frequency" context="{'group_by': 'tt_pay_frequency_id'}"/>
                    <filter string="Setup Status" name="group_setup_status" context="{'group_by': 'tt_payroll_readiness_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tt_payroll_employees" model="ir.actions.act_window">
        <field name="name">TT Payroll Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tt_payroll_employee_search"/>
        <field name="domain">[('active', '=', True), ('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_tt_payroll_status': 'active'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first payroll employee</p>
            <p>This workspace uses the same employees already stored in Odoo.</p>
        </field>
    </record>

    <record id="action_tt_payroll_employees_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_tt_payroll_employee_list"/>
        <field name="act_window_id" ref="action_tt_payroll_employees"/>
    </record>

    <record id="action_tt_payroll_employees_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tt_payroll_employee_form"/>
        <field name="act_window_id" ref="action_tt_payroll_employees"/>
    </record>

    <record id="action_tt_payroll_employee_setup" model="ir.actions.act_window">
        <field name="name">Employee Setup</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tt_payroll_employee_search"/>
        <field name="domain">[('active', '=', True), ('company_id', 'in', allowed_company_ids), ('tt_payroll_status', '!=', 'excluded')]</field>
        <field name="context">{'search_default_tt_setup_incomplete': 1, 'default_tt_payroll_status': 'active'}</field>
    </record>

    <record id="action_tt_payroll_employee_setup_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_tt_payroll_employee_list"/>
        <field name="act_window_id" ref="action_tt_payroll_employee_setup"/>
    </record>

    <record id="action_tt_payroll_employee_setup_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tt_payroll_employee_form"/>
        <field name="act_window_id" ref="action_tt_payroll_employee_setup"/>
    </record>

    <!-- Optional payroll columns and filters remain available in the normal HR app. -->
    <record id="view_employee_tree_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.list.trinidad.payroll.fields</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="tt_employee_number" optional="hide" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_payroll_status" widget="badge" optional="hide" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_pay_frequency_id" optional="hide" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_payroll_readiness_state" string="Payroll Setup" widget="badge" optional="hide" groups="spx_tt_payroll.group_tt_payroll_user"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_search_tt_payroll" model="ir.ui.view">
        <field name="name">hr.employee.search.trinidad.payroll.filters</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="tt_employee_number" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_payroll_group_id" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <field name="tt_pay_frequency_id" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <separator groups="spx_tt_payroll.group_tt_payroll_user"/>
                <filter name="tt_payroll_active" string="Payroll Active" domain="[('tt_payroll_status', '=', 'active')]" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <filter name="tt_payroll_incomplete" string="Payroll Needs Attention" domain="[('tt_payroll_readiness_state', '=', 'incomplete')]" groups="spx_tt_payroll.group_tt_payroll_user"/>
                <group groups="spx_tt_payroll.group_tt_payroll_user">
                    <filter string="Payroll Group" name="group_tt_payroll" context="{'group_by': 'tt_payroll_group_id'}"/>
                    <filter string="Pay Frequency" name="group_tt_frequency" context="{'group_by': 'tt_pay_frequency_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
