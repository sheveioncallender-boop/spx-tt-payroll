<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_payroll_group_list" model="ir.ui.view">
        <field name="name">spx.tt.payroll.group.list</field>
        <field name="model">spx.tt.payroll.group</field>
        <field name="arch" type="xml">
            <list string="Payroll Groups" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="pay_frequency_id"/>
                <field name="normal_hours_per_day"/>
                <field name="normal_hours_per_week"/>
                <field name="employee_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tt_payroll_group_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.group.form</field>
        <field name="model">spx.tt.payroll.group</field>
        <field name="arch" type="xml">
            <form string="Payroll Group">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Example: Monthly Salaried Employees"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="pay_frequency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Normal Working Hours">
                            <field name="normal_hours_per_day"/>
                            <field name="normal_hours_per_week"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Optional notes about this payroll group..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tt_payroll_group_search" model="ir.ui.view">
        <field name="name">spx.tt.payroll.group.search</field>
        <field name="model">spx.tt.payroll.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="pay_frequency_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Pay Frequency" name="group_frequency" context="{'group_by': 'pay_frequency_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tt_payroll_groups" model="ir.actions.act_window">
        <field name="name">Payroll Groups</field>
        <field name="res_model">spx.tt.payroll.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tt_payroll_group_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a payroll group</p>
            <p>Use groups for employees who share the same pay frequency and normal working hours.</p>
        </field>
    </record>
</odoo>
