<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_employee_pay_item_list" model="ir.ui.view">
        <field name="name">spx.tt.employee.pay.item.list</field>
        <field name="model">spx.tt.employee.pay.item</field>
        <field name="arch" type="xml">
            <list string="Recurring Earnings and Deductions">
                <field name="employee_id"/>
                <field name="pay_item_id"/>
                <field name="category" widget="badge"/>
                <field name="calculation_method" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reference" optional="hide"/>
                <field name="amount"/>
                <field name="percentage" optional="hide"/>
                <field name="remaining_balance" optional="hide"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tt_employee_pay_item_form" model="ir.ui.view">
        <field name="name">spx.tt.employee.pay.item.form</field>
        <field name="model">spx.tt.employee.pay.item</field>
        <field name="arch" type="xml">
            <form string="Recurring Payroll Item">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="pay_item_id"/>
                            <field name="category" readonly="1"/>
                            <field name="calculation_method" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" invisible="calculation_method not in ['fixed', 'manual']"/>
                            <field name="percentage" invisible="calculation_method != 'percentage'"/>
                            <field name="quantity" invisible="calculation_method != 'hours'"/>
                            <field name="reference"/>
                            <field name="original_balance"/>
                            <field name="remaining_balance"/>
                            <field name="show_on_payslip"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
