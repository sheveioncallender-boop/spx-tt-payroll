<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_payroll_readiness_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.readiness.form</field>
        <field name="model">spx.tt.payroll.readiness</field>
        <field name="arch" type="xml">
            <form string="Payroll Readiness" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_all" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_total" widget="statinfo" string="Employees"/>
                        </button>
                        <button name="action_open_ready" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="ready_count" widget="statinfo" string="Ready"/>
                        </button>
                        <button name="action_open_incomplete" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="incomplete_count" widget="statinfo" string="Needs Setup"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>Payroll Readiness</h1>
                        <p class="text-muted">All active Odoo employees are reviewed unless Payroll Status is set to Excluded.</p>
                    </div>
                    <field name="company_id" groups="base.group_multi_company"/>

                    <div class="alert alert-info" role="alert">
                        Complete only the items that apply. You can return to this page at any time; there is no mandatory setup wizard.
                    </div>

                    <group string="Items Requiring Attention">
                        <group>
                            <button name="action_open_missing_pay" type="object" class="btn btn-link" string="Pay information missing"/>
                            <field name="missing_pay_count" readonly="1"/>
                            <button name="action_open_missing_frequency" type="object" class="btn btn-link" string="Pay frequency missing"/>
                            <field name="missing_frequency_count" readonly="1"/>
                            <button name="action_open_missing_schedule" type="object" class="btn btn-link" string="Work schedule missing"/>
                            <field name="missing_schedule_count" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_open_missing_bir" type="object" class="btn btn-link" string="BIR number missing"/>
                            <field name="missing_bir_count" readonly="1"/>
                            <button name="action_open_missing_nis" type="object" class="btn btn-link" string="NIS information missing"/>
                            <field name="missing_nis_count" readonly="1"/>
                            <button name="action_open_missing_bank" type="object" class="btn btn-link" string="Bank information missing"/>
                            <field name="missing_bank_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary" icon="fa-refresh"/>
                    <button name="action_open_incomplete" type="object" string="Review Employees" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tt_payroll_readiness_window" model="ir.actions.act_window">
        <field name="name">Payroll Readiness</field>
        <field name="res_model">spx.tt.payroll.readiness</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_tt_payroll_readiness_form"/>
        <field name="target">current</field>
    </record>

    <record id="action_tt_payroll_readiness" model="ir.actions.server">
        <field name="name">Open Payroll Readiness</field>
        <field name="model_id" ref="model_spx_tt_payroll_readiness"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_readiness()</field>
    </record>
</odoo>
