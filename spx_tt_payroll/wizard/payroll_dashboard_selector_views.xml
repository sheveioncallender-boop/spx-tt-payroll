<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_payroll_dashboard_selector_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.dashboard.selector.form</field>
        <field name="model">spx.tt.payroll.dashboard.selector</field>
        <field name="arch" type="xml">
            <form string="Select Payroll">
                <group>
                    <field name="dashboard_id" invisible="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="payroll_run_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Open Payroll" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
