<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_payroll_hours_adjustment_wizard_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.hours.adjustment.wizard.form</field>
        <field name="model">spx.tt.payroll.hours.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Payable Hours">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This change will immediately recalculate wages, statutory deductions, gross pay, and net pay. A permanent audit entry will be saved.
                    </div>
                    <group>
                        <group string="Employee and Payroll">
                            <field name="run_employee_id" invisible="1"/>
                            <field name="employee_id"/>
                            <field name="payroll_run_id"/>
                            <field name="expected_hours"/>
                        </group>
                        <group string="Current Hours">
                            <field name="current_payable_hours"/>
                            <field name="current_adjustment_hours"/>
                        </group>
                    </group>
                    <group>
                        <group string="Adjustment">
                            <field name="adjustment_hours" placeholder="Example: 8.00 or -4.00"/>
                            <field name="reason" placeholder="Example: Department confirmed missing clock-in"/>
                            <field name="supporting_note" placeholder="Optional approval reference or additional explanation..."/>
                        </group>
                        <group string="Preview">
                            <field name="new_adjustment_total"/>
                            <field name="estimated_payable_hours"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_adjustment" type="object" string="Apply and Recalculate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_tt_payroll_hours_adjustment_list" model="ir.ui.view">
        <field name="name">spx.tt.payroll.hours.adjustment.list</field>
        <field name="model">spx.tt.payroll.hours.adjustment</field>
        <field name="arch" type="xml">
            <list string="Payable Hours Adjustment History" create="0" edit="0" delete="0">
                <field name="adjusted_at"/>
                <field name="employee_id" optional="show"/>
                <field name="run_id" optional="show"/>
                <field name="change_hours"/>
                <field name="previous_payable_hours" optional="show"/>
                <field name="new_payable_hours" optional="show"/>
                <field name="reason"/>
                <field name="adjusted_by"/>
            </list>
        </field>
    </record>

    <record id="view_tt_payroll_hours_adjustment_form" model="ir.ui.view">
        <field name="name">spx.tt.payroll.hours.adjustment.form</field>
        <field name="model">spx.tt.payroll.hours.adjustment</field>
        <field name="arch" type="xml">
            <form string="Payable Hours Adjustment" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Payroll">
                            <field name="employee_id"/>
                            <field name="run_id"/>
                            <field name="adjusted_at"/>
                            <field name="adjusted_by"/>
                        </group>
                        <group string="Hours">
                            <field name="previous_adjustment_hours"/>
                            <field name="change_hours"/>
                            <field name="new_adjustment_hours"/>
                            <field name="previous_payable_hours"/>
                            <field name="new_payable_hours"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pay Before and After">
                            <field name="currency_id" invisible="1"/>
                            <field name="previous_gross_pay" widget="monetary"/>
                            <field name="new_gross_pay" widget="monetary"/>
                            <field name="previous_net_pay" widget="monetary"/>
                            <field name="new_net_pay" widget="monetary"/>
                        </group>
                        <group string="Explanation">
                            <field name="reason"/>
                            <field name="supporting_note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
